# Public runtime config for the IronLog app.
# Copy this to `.env` and adjust per environment. Variables prefixed with
# EXPO_PUBLIC_ are inlined into the JS bundle at build time (not secret).

# Base URL of the IronLog backend API. When unset, the app falls back to the
# production Azure URL (see src/services/api.ts), so you only need to set this to
# point a build at a local or staging backend, e.g.:
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
EXPO_PUBLIC_API_URL=https://efitness-backend-2530307.azurewebsites.net
